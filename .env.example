# AgentTrail environment variables (set these in the shell / service manager;
# the app does not parse .env automatically).
AGENTTRAIL_HOST=127.0.0.1
AGENTTRAIL_PORT=8787
# AGENTTRAIL_DB=D:\path\to\agenttrail.db
# AGENTTRAIL_DATA_DIR=D:\path\to\data
AGENTTRAIL_ADMIN_USER=admin
# Set a strong password before first start.
AGENTTRAIL_ADMIN_PASSWORD=change-me-to-a-long-random-password
# Set to 1 behind HTTPS reverse proxy.
# AGENTTRAIL_SECURE_COOKIE=1
# Disable scheduler for tests or read-only inspection.
# AGENTTRAIL_DISABLE_SCHEDULER=1
# Optional zstd executable when the Python zstandard package is unavailable.
# AGENTTRAIL_ZSTD=C:\tools\zstd.exe
